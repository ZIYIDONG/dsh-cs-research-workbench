{
  "name": "dsh-cs-research-workbench",
  "version": "0.1.0",
  "description": "An end-to-end research workbench for Computer Science: todos, papers, projects, ideas, knowledge base, sync and backup",
  "main": "./lib/index.js",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.16",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-csrw",
    "research",
    "computer-science",
    "research-workflow",
    "obsidian",
    "zotero",
    "webdav"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "bin": {
    "dsh-csrw": "./bin/dsh-csrw.js"
  },
  "files": [
    "lib",
    "bin",
    "patches",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    ".dsh-csrw.example.json",
    "scripts/check.mjs",
    "scripts/check-identifiers.mjs",
    "test/*.test.js",
    "client.js",
    "scripts/verify-ui.mjs",
    "scripts/verify-ui-interaction.mjs"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.mjs && node scripts/check-identifiers.mjs",
    "check:ui": "node scripts/verify-ui.mjs && node scripts/verify-ui-interaction.mjs"
  },
  "dsh": {
    "name": "CS科研工作台 (dsh-cs-research-workbench)",
    "category": "research",
    "bundle": {
      "patch": "./patches/bundle.yaml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1"
  }
}
